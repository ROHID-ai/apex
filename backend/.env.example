# ============================================
# GymLink Backend Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# App
APP_NAME=GymLink
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql://gymlink:gymlink_secret@localhost:5432/gymlink_db

# JWT Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# QR Code
QR_SECRET_KEY=your-qr-hmac-secret-key-change-this
QR_EXPIRY_SECONDS=300

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Admin Seed (first admin created on startup)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin
